# Copy this file to .env and fill in real values there.
# .env is gitignored -- never commit real secrets. Fill these in directly in
# a text editor on your own machine, not by pasting them into a chat/AI tool.

# Full SAS URL for Stanford AIMI's CheXpert Azure blob container (ask your
# professor / whoever has Stanford AIMI dataset access for this). Used by
# src/data/download_chexpert.py and scripts/download_chexpert_subset.py.
# Falls back to secrets/chexpert_sas_url.txt if left blank here.
CHEXPERT_SAS_URL=

# GitHub Personal Access Token (repo scope) used only by
# colab/run_remote_pipeline.sh to push results back to GitHub as a backup
# after a remote Colab run finishes. Not needed for anything else.
GITHUB_TOKEN=
